# OpsMind Backend Environment Configuration

# Server
APP_NAME=OpsMind
APP_ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database
# Use PostgreSQL URL if available, otherwise sqlite:///./opsmind.db is automatically used as fallback
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opsmind

# Hindsight Configuration
# Vectorize Hindsight API Endpoint (Cloud or Self-hosted on Docker port 8888)
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=opsmind-incidents

# LLM Configuration (Provider options: gemini, openai, anthropic, or mock)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Simulation Mode (Executes simulated DevOps actions such as restart, pool resize)
SIMULATION_MODE=true
